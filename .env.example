CACHE_DRIVER=file
SESSION_DRIVER=file
QUEUE_CONNECTION=sync

# === E-mail ===
# O site nao envia e-mail: o contato acontece por WhatsApp, telefone ou
# pelo endereco de e-mail publicado na pagina de Contato. As chaves MAIL_*
# do Laravel ficam nos padroes e nao precisam ser configuradas.
