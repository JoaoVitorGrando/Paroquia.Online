APP_NAME="Paróquia Online"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack

DB_CONNECTION=sqlite
# Com SQLite, deixe DB_DATABASE comentado: o Laravel usa database/database.sqlite
# Para usar MySQL, troque para DB_CONNECTION=mysql e descomente as linhas abaixo:
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=paroquia_online
# DB_USERNAME=root
# DB_PASSWORD=

# === Acesso do administrador (usado pelo AdminSeeder) ===
ADMIN_EMAIL=admin@paroquia.com
ADMIN_SENHA=trocar-esta-senha

# === Dados institucionais da paróquia ===
PAROQUIA_NOME="Paróquia Nossa Senhora da Glória"
PAROQUIA_CNPJ="11.543.643/0006-28"
PAROQUIA_TELEFONE="(42) 3646-1336"
PAROQUIA_CELULAR="(42) 99820-4618"
PAROQUIA_WHATSAPP=5542998204618
PAROQUIA_EMAIL=pnsgpitanga@gmail.com

# Endereço
PAROQUIA_LOGRADOURO="Rua Conselheiro Zacarias"
PAROQUIA_NUMERO=890
PAROQUIA_BAIRRO=Centro
PAROQUIA_CEP=85200-053
PAROQUIA_CIDADE=Pitanga
